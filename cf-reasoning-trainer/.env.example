# Placeholders only. For a fresh local database, run npm run setup:local.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=http://127.0.0.1:5000
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:55432/REPLACE_DATABASE
DATABASE_ID=REPLACE_WITH_GENERATED_UUID
SESSION_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET
TRUST_PROXY=none
# Mock processing can persist synthetic results with the defaults below.
# Live requests require AI_ENABLED=true, AI_DRY_RUN=false and AI_PROVIDER=openai.
AI_ENABLED=false
AI_DRY_RUN=true
AI_PROVIDER=mock
AI_BATCH_SIZE=1
AI_MAX_ATTEMPTS=2
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=6000
AI_SPEND_LIMIT_USD=0
AI_PAID_APPROVAL_ID=
AI_APPROVED_PROBLEM_KEYS=
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
OPENAI_STANDARD_MODEL=gpt-6.1-sol
OPENAI_STRONG_MODEL=gpt-6-astra
# Copy current official prices for the exact configured IDs before any live request.
OPENAI_STANDARD_INPUT_USD_PER_M=0
OPENAI_STANDARD_OUTPUT_USD_PER_M=0
OPENAI_STRONG_INPUT_USD_PER_M=0
OPENAI_STRONG_OUTPUT_USD_PER_M=0

# Separate opt-in; requires a scoped approval document and positive spending cap.
AI_BACKFILL_ENABLED=false
